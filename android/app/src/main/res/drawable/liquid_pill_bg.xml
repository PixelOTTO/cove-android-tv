<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F4FFFFFF" android:endColor="#BDE8F5FF" />
            <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#AD7DDCFF" android:endColor="#7355A8E8" />
            <stroke android:width="1.5dp" android:color="#D8F4FFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#55E7F8FF" android:endColor="#284A80B6" />
                    <stroke android:width="1dp" android:color="#73EAFBFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
