<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#76A6F5FF" android:endColor="#7A7497FF" />
            <stroke android:width="1.5dp" android:color="#ECFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#526BCBEA" android:endColor="#4F7775D8" />
            <stroke android:width="1dp" android:color="#A8E7FBFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#3BE8F7FF" android:endColor="#283F68A5" />
            <stroke android:width="1dp" android:color="#58E6F8FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
