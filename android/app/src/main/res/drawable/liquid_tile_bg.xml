<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#63DDFBFF"
                android:centerColor="#3A79C8E8" android:endColor="#2740608B" />
            <stroke android:width="1dp" android:color="#A6F4FCFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#52FFFFFF"
                android:centerColor="#17FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
